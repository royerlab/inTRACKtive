{
  "name": "inTRACKtive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:python": "tsc && vite build && mkdir -p python/src/intracktive/frontend/assets && cp dist/index.html dist/spark1.png dist/Biohub_logo_60x60.png dist/icon_zebrafish.png python/src/intracktive/frontend/ && cp dist/assets/* python/src/intracktive/frontend/assets/",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@czi-sds/components": "^21.6.3",
    "@emotion/css": "^11.11.2",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/base": "^5.0.0-beta.40",
    "@mui/icons-material": "^5.15.15",
    "@mui/lab": "^5.0.0-alpha.170",
    "@mui/material": "^5.15.15",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "zarr": "^0.6.2"
  },
  "devDependencies": {
    "@testing-library/react": "^14.2.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-istanbul": "^4.1.12",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.60.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "prettier": {
    "semi": true,
    "quoteProps": "consistent",
    "tabWidth": 4,
    "printWidth": 120,
    "trailingComma": "all",
    "bracketSpacing": true
  }
}
